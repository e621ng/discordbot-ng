{
  "name": "discordbot-ng",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/node": "22.15.21",
    "copyfiles": "2.4.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "rimraf": "6.1.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "dependencies": {
    "@clynamic/dmark": "0.0.11",
    "@hono/node-server": "2.1.8",
    "@redis/client": "5.1.0",
    "discord.js": "14.28.1",
    "hono": "4.13.19",
    "sqlite": "5.1.1",
    "sqlite3": "6.0.1"
  },
  "scripts": {
    "dev": "tsx watch --enable-source-maps --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "lint": "npx eslint .",
    "typecheck": "npx tsc --noEmit",
    "build": "npm run clean && node scripts/build.js && npm run copyfiles",
    "clean": "rimraf dist",
    "copyfiles": "copyfiles -u 1 \"./src/**/*.html\" ./dist",
    "encrypt": "node --env-file=.env ./scripts/encrypt-data.js",
    "add-author-hash": "node --env-file=.env ./scripts/add-author-id-hash.js"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sqlite3@6.0.1": true
  }
}
